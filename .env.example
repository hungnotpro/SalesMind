# PostgreSQL connection
# Required for PostgreSQL persistence layer (SM-004).
# Example: postgres://user:password@localhost:5432/salesmind
DATABASE_URL=postgres://user:password@localhost:5432/salesmind

# Optional PostgreSQL pool tuning
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Set to "true" to run against PostgreSQL instead of in-memory repositories.
# When false, the application uses InMemoryRepositories (legacy).
USE_POSTGRES=false
